      <span style="display:inline-block;margin-bottom:12px;padding:4px 12px;border-radius:10px;font-size:11px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;background:rgba(143,208,234,0.18);color:#B3CFE0;border:1px solid rgba(143,208,234,0.3);">Service Area</span>
